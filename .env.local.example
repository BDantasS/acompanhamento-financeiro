# Copie para .env.local e preencha.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: usada só no servidor (webhook do Telegram). Nunca exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: crie o bot com o @BotFather
TELEGRAM_BOT_TOKEN=
# Nome do bot sem @ (só para mostrar o link no app)
TELEGRAM_BOT_USERNAME=
# Qualquer string aleatória (A-Z, a-z, 0-9, _ e -). Usada para validar o webhook.
TELEGRAM_WEBHOOK_SECRET=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional: modelo usado para interpretar as mensagens (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5
